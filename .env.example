# Application
APP_ENV=development
LOG_LEVEL=INFO
AUTH_SECRET=generate-a-long-random-secret
TOKEN_MINUTES=60
# JSON values must contain password_hash fields generated with the project utility.
AUTH_USERS_JSON=

# Kubernetes
KUBERNETES_NAMESPACE=hospital
KUBERNETES_IN_CLUSTER=false

# Monitoring
PROMETHEUS_URL=http://prometheus.monitoring.svc.cluster.local:9090

# Database; do not commit real credentials
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hospital_cloud
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-locally
DATABASE_URL=postgresql+psycopg://app:change-me-locally@localhost:5432/hospital_cloud
DATABASE_REQUIRED=false

# Predictive scaling defaults
PREDICTIVE_SCALING_ENABLED=false
PREDICTIVE_SCALING_DRY_RUN=true
ENABLE_AUTOMATIC_SCALING=false
SCALING_DEPLOYMENT=patient-service
MIN_REPLICAS=1
MAX_REPLICAS=10
SCALING_COOLDOWN_SECONDS=300
